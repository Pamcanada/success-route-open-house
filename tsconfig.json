{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/config/eventConfig": [
        "./eventConfig.ts"
      ],
      "@/lib/calendar": [
        "./calendar.ts"
      ],
      "@/lib/registration": [
        "./registration.ts"
      ],
      "@/lib/timeSlots": [
        "./timeSlots.ts"
      ],
      "@/lib/tracking": [
        "./tracking.ts"
      ],
      "@/lib/qr": [
        "./qr.ts"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
